rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (request.auth.token.email == "76076ck@gmail.com" || request.auth.uid == "usr_super_admin");
    }

    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow write: if isOwner(userId) || isSuperAdmin();
    }

    match /export_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin() || isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }
  }
}
